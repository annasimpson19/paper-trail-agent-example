# An Ethereum mainnet RPC (Alchemy, Infura, or your own node)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# AI Agents stage (npm run register-identity, npm run stage): the agent's own wallet key.
# Needed even for a dry run, because the operator declaration is signed by this wallet. Never commit a real key.
AGENT_PRIVATE_KEY=
# The operator and the agent, as they will appear in the public record of the acquisition (operator-declared).
OPERATOR_NAME=
AGENT_NAME=
# The ERC-8004 identity whose agent wallet or owner is the wallet above (npm run register-identity prints it).
ERC8004_AGENT_ID=
# Only for register-identity: the agent registration file (ERC-8004: type, name, description, image, services, ...).
AGENT_URI=

# Public stage (npm run agent, npm run mint): only for --execute. The operator's funded key. Never commit a real key.
PRIVATE_KEY=
